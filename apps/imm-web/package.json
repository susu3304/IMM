{
  "name": "imm-web-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/imm-wasm --target web --release --out-dir ../../apps/imm-web/src/wasm/pkg --out-name imm_wasm --no-pack --no-opt -- --locked",
    "dev": "npm run build:wasm && concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run build:wasm && tsc -p tsconfig.server.json && tsc -p tsconfig.worker.json && vite build",
    "deploy:cf": "npm run build && wrangler deploy",
    "deploy:cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "start": "node dist/server/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:wasm": "npm run build:wasm && tsx scripts/smoke-wasm.ts"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.1",
    "express": "^5.1.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@cloudflare/workers-types": "^4.20260523.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "wasm-pack": "^0.15.0",
    "wrangler": "^4.94.0"
  }
}
