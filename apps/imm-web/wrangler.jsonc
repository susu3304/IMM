{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imm-web-runner",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-23",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/downloads/vscode/latest.vsix"
    ]
  },
  "routes": [
    {
      "pattern": "imm.nkmz.jp",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
